<Window x:Class="KeyHolder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:KeyHolder.Desktop.Views"
        mc:Ignorable="d"
        Title="KeyHolder"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fake-data warning, always visible. -->
        <Border Grid.Row="0"
                Padding="16,8"
                Background="#3B2F0B"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource WarningBrush}"
                           Text="{Binding Banner}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="12,4"
                        Command="{Binding LockCommand}"
                        Content="Lock"
                        Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <views:LockedView Grid.Row="1"
                          Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />

        <views:VaultView Grid.Row="1"
                         DataContext="{Binding Vault}"
                         Visibility="{Binding DataContext.IsUnlocked, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <!-- Status bar: message on the left, entry count and replica dirty state on the right. -->
        <Border Grid.Row="2"
                Padding="16,6"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,16,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Vault.EntryCountText}" />
                    <TextBlock FontSize="12" Text="{Binding Vault.DirtyText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vault.IsDirty}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
