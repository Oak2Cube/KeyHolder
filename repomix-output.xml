<file path="src/KeyHolder.Desktop/Services/IdleActivityMonitor.cs">
using System.Windows.Input;
using System.Windows.Threading;
using KeyHolder.Domain.Locking;

namespace KeyHolder.Desktop.Services;

/// <summary>
/// Feeds user input into <see cref="VaultLockPolicy"/> and checks the idle timeout once per second.
/// </summary>
internal sealed class IdleActivityMonitor : IDisposable
{
    private readonly VaultLockPolicy _policy;
    private readonly DispatcherTimer _timer;
    private bool _started;

    public IdleActivityMonitor(VaultLockPolicy policy)
    {
        ArgumentNullException.ThrowIfNull(policy);

        _policy = policy;
        _timer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(1) };
        _timer.Tick += (_, _) => _policy.CheckIdle();
    }

    public void Start()
    {
        if (_started)
        {
            return;
        }

        _started = true;
        InputManager.Current.PreProcessInput += OnPreProcessInput;
        _timer.Start();
    }

    public void Dispose()
    {
        if (!_started)
        {
            return;
        }

        _started = false;
        _timer.Stop();
        InputManager.Current.PreProcessInput -= OnPreProcessInput;
    }

    private void OnPreProcessInput(object sender, PreProcessInputEventArgs e)
    {
        if (e.StagingItem.Input is MouseEventArgs or KeyboardEventArgs)
        {
            _policy.RecordActivity();
        }
    }
}
</file>

<file path="src/KeyHolder.Desktop/Services/SessionLockMonitor.cs">
using System.Windows;
using KeyHolder.Domain.Locking;
using Microsoft.Win32;

namespace KeyHolder.Desktop.Services;

/// <summary>
/// Locks the vault when Windows locks the session (Win+L) or the user disconnects.
/// </summary>
internal sealed class SessionLockMonitor : IDisposable
{
    private readonly VaultLockPolicy _policy;
    private bool _started;

    public SessionLockMonitor(VaultLockPolicy policy)
    {
        ArgumentNullException.ThrowIfNull(policy);
        _policy = policy;
    }

    public void Start()
    {
        if (_started)
        {
            return;
        }

        _started = true;
        SystemEvents.SessionSwitch += OnSessionSwitch;
    }

    public void Dispose()
    {
        if (!_started)
        {
            return;
        }

        _started = false;
        SystemEvents.SessionSwitch -= OnSessionSwitch;
    }

    // SystemEvents are raised on a background thread. The policy and view models belong to the UI thread.
    private void OnSessionSwitch(object sender, SessionSwitchEventArgs e)
    {
        if (e.Reason is not (SessionSwitchReason.SessionLock
            or SessionSwitchReason.ConsoleDisconnect
            or SessionSwitchReason.RemoteDisconnect))
        {
            return;
        }

        Application.Current?.Dispatcher.BeginInvoke(() => _policy.Lock(LockReason.SessionLock));
    }
}
</file>

<file path="src/KeyHolder.Desktop/Services/WindowsClipboardService.cs">
using System.IO;
using System.Runtime.InteropServices;
using System.Windows;
using System.Windows.Threading;

namespace KeyHolder.Desktop.Services;

/// <summary>
/// WPF clipboard with Windows clipboard-history exclusion and an ownership check.
/// </summary>
internal sealed partial class WindowsClipboardService : IClipboardService, IDisposable
{
    private const int RetryCount = 5;
    private static readonly TimeSpan RetryDelay = TimeSpan.FromMilliseconds(50);

    private readonly DispatcherTimer _timer = new();
    private uint _ownedSequence;
    private bool _owns;

    public WindowsClipboardService()
    {
        _timer.Tick += (_, _) =>
        {
            _timer.Stop();
            ClearIfOwned();
        };
    }

    public void SetSecret(string text, TimeSpan clearAfter)
    {
        ArgumentException.ThrowIfNullOrEmpty(text);

        var data = new DataObject();
        data.SetText(text, TextDataFormat.UnicodeText);

        // Windows 10/11 clipboard history, cloud clipboard, and monitors honor these formats.
        data.SetData("ExcludeClipboardContentFromMonitorProcessing", new MemoryStream(BitConverter.GetBytes(1)));
        data.SetData("CanIncludeInClipboardHistory", new MemoryStream(BitConverter.GetBytes(0)));
        data.SetData("CanUploadToCloudClipboard", new MemoryStream(BitConverter.GetBytes(0)));

        Retry(() => Clipboard.SetDataObject(data, copy: false));

        _ownedSequence = GetClipboardSequenceNumber();
        _owns = true;

        _timer.Stop();
        _timer.Interval = clearAfter;
        _timer.Start();
    }

    public void ClearIfOwned()
    {
        _timer.Stop();

        if (!_owns)
        {
            return;
        }

        _owns = false;

        // If another app copied something since, the sequence number changed and we leave it alone.
        if (GetClipboardSequenceNumber() == _ownedSequence)
        {
            Retry(Clipboard.Clear);
        }
    }

    public void Dispose() => ClearIfOwned();

    [LibraryImport("user32.dll")]
    private static partial uint GetClipboardSequenceNumber();

    private static void Retry(Action action)
    {
        for (var attempt = 1; ; attempt++)
        {
            try
            {
                action();
                return;
            }
            catch (COMException) when (attempt < RetryCount)
            {
                // The clipboard may be locked by another process for a moment.
                Thread.Sleep(RetryDelay);
            }
        }
    }
}
</file>

