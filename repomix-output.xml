<file path="src/KeyHolder.Infrastructure/InMemory/InMemoryEntryRepository.cs">
using KeyHolder.Domain.Entries;
using KeyHolder.Infrastructure.FakeData;

namespace KeyHolder.Infrastructure.InMemory;

/// <summary>
/// Thread-safe in-memory repository. It behaves like the SQLite repository and is used for contract tests
/// and design-time previews.
/// </summary>
public sealed class InMemoryEntryRepository : IEntryRepository, IVaultStateStore, IFakeDataStore
{
    private readonly object _gate = new();
    private readonly Dictionary<Guid, VaultEntry> _entries = [];
    private bool _dirty;
    private bool _seeded;

    public Task<IReadOnlyList<EntrySummary>> ListSummariesAsync(CancellationToken cancellationToken = default)
    {
        lock (_gate)
        {
            return Task.FromResult<IReadOnlyList<EntrySummary>>(
                _entries.Values.Select(entry => entry.ToSummary()).ToList());
        }
    }

    public Task<EntrySummary?> GetSummaryAsync(Guid id, CancellationToken cancellationToken = default)
    {
        lock (_gate)
        {
            return Task.FromResult(_entries.TryGetValue(id, out var entry) ? entry.ToSummary() : null);
        }
    }

    public Task<EntrySecret?> GetSecretAsync(Guid id, CancellationToken cancellationToken = default)
    {
        lock (_gate)
        {
            return Task.FromResult(_entries.TryGetValue(id, out var entry) ? entry.Secret : null);
        }
    }

    public Task<VaultEntry?> GetAsync(Guid id, CancellationToken cancellationToken = default)
    {
        lock (_gate)
        {
            return Task.FromResult(_entries.GetValueOrDefault(id));
        }
    }

    public Task AddAsync(VaultEntry entry, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entry);

        var valid = entry with
        {
            Metadata = EntryValidator.EnsureValid(entry.Metadata),
            Secret = EntryValidator.EnsureValid(entry.Secret),
        };

        lock (_gate)
        {
            if (!_entries.TryAdd(valid.Id, valid))
            {
                throw new InvalidOperationException("An entry with this id already exists.");
            }

            _dirty = true;
        }

        return Task.CompletedTask;
    }

    public Task<bool> UpdateAsync(
        Guid id,
        EntryMetadata metadata,
        EntrySecret? newSecret,
        DateTimeOffset now,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(metadata);

        var normalizedMetadata = EntryValidator.EnsureValid(metadata);
        var normalizedSecret = newSecret is null ? null : EntryValidator.EnsureValid(newSecret);

        lock (_gate)
        {
            if (!_entries.TryGetValue(id, out var existing))
            {
                return Task.FromResult(false);
            }

            _entries[id] = existing with
            {
                Metadata = normalizedMetadata,
                Secret = normalizedSecret ?? existing.Secret,
                UpdatedAt = now,
            };
            _dirty = true;
            return Task.FromResult(true);
        }
    }

    public Task<bool> DeleteAsync(Guid id, CancellationToken cancellationToken = default)
    {
        lock (_gate)
        {
            var removed = _entries.Remove(id);
            _dirty |= removed;
            return Task.FromResult(removed);
        }
    }

    public Task<bool> GetLocalChangedSinceReplicaAsync(CancellationToken cancellationToken = default)
    {
        lock (_gate)
        {
            return Task.FromResult(_dirty);
        }
    }

    public Task<bool> SeedOnceAsync(
        IReadOnlyList<VaultEntry> entries,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entries);

        lock (_gate)
        {
            if (_seeded)
            {
                return Task.FromResult(false);
            }

            foreach (var entry in entries)
            {
                _entries[entry.Id] = entry with
                {
                    Metadata = EntryValidator.EnsureValid(entry.Metadata),
                    Secret = EntryValidator.EnsureValid(entry.Secret),
                };
            }

            _seeded = true;
            return Task.FromResult(true);
        }
    }
}
</file>

<file path="src/KeyHolder.Infrastructure/Persistence/InitialSchemaMigration.cs">
using System.Globalization;
using Microsoft.Data.Sqlite;

namespace KeyHolder.Infrastructure.Persistence;

/// <summary>
/// Milestone 1 schema. Metadata and secret fields are plain columns in separate groups
/// (with separate revisions) so Milestone 2 can replace them with
/// <c>metadata_envelope</c> and <c>secret_envelope</c> in a later migration.
/// This schema holds FAKE data only.
/// </summary>
internal sealed class InitialSchemaMigration : IMigration
{
    public int Version => 1;

    public void Apply(SqliteConnection connection, SqliteTransaction transaction)
    {
        using var create = connection.CreateCommand();
        create.Transaction = transaction;
        create.CommandText = """
            CREATE TABLE vault (
                id               TEXT PRIMARY KEY NOT NULL,
                created_at       TEXT NOT NULL,
                fake_data_seeded INTEGER NOT NULL DEFAULT 0
            );

            CREATE TABLE entry (
                id                TEXT PRIMARY KEY NOT NULL,
                vault_id          TEXT NOT NULL REFERENCES vault (id),

                -- metadata group
                title             TEXT NOT NULL CHECK (length(trim(title)) > 0),
                username          TEXT,
                email             TEXT,
                url               TEXT,
                d_tags            TEXT NOT NULL DEFAULT '[]',
                s_tags            TEXT NOT NULL DEFAULT '[]',
                importance        INTEGER,
                metadata_revision INTEGER NOT NULL DEFAULT 1,

                -- secret group
                password          TEXT,
                notes             TEXT,
                secret_revision   INTEGER NOT NULL DEFAULT 1,

                created_at        TEXT NOT NULL,
                updated_at        TEXT NOT NULL
            );

            CREATE INDEX ix_entry_vault ON entry (vault_id);

            CREATE TABLE replica_state (
                vault_id                    TEXT PRIMARY KEY NOT NULL REFERENCES vault (id),
                replica_path                TEXT,
                last_exported_at            TEXT,
                local_changed_since_replica INTEGER NOT NULL DEFAULT 0
            );
            """;
        create.ExecuteNonQuery();

        var vaultId = Guid.NewGuid().ToString("D");
        var now = DateTimeOffset.UtcNow.ToString("O", CultureInfo.InvariantCulture);

        using var insertVault = connection.CreateCommand();
        insertVault.Transaction = transaction;
        insertVault.CommandText = "INSERT INTO vault (id, created_at) VALUES ($id, $created)";
        insertVault.Parameters.AddWithValue("$id", vaultId);
        insertVault.Parameters.AddWithValue("$created", now);
        insertVault.ExecuteNonQuery();

        using var insertState = connection.CreateCommand();
        insertState.Transaction = transaction;
        insertState.CommandText = "INSERT INTO replica_state (vault_id) VALUES ($id)";
        insertState.Parameters.AddWithValue("$id", vaultId);
        insertState.ExecuteNonQuery();
    }
}
</file>

<file path="src/KeyHolder.Infrastructure/Persistence/SchemaMigrator.cs">
using System.Globalization;
using Microsoft.Data.Sqlite;

namespace KeyHolder.Infrastructure.Persistence;

/// <summary>
/// One schema step. Versions start at 1 and increase by exactly 1.
/// </summary>
internal interface IMigration
{
    int Version { get; }

    void Apply(SqliteConnection connection, SqliteTransaction transaction);
}

/// <summary>
/// Thrown when the database was written by a newer version of the app.
/// </summary>
public sealed class UnsupportedSchemaVersionException : Exception
{
    public UnsupportedSchemaVersionException()
        : base("The database schema version is not supported.")
    {
    }

    public UnsupportedSchemaVersionException(string message)
        : base(message)
    {
    }

    public UnsupportedSchemaVersionException(string message, Exception innerException)
        : base(message, innerException)
    {
    }
}

/// <summary>
/// Applies ordered schema migrations. The applied version is stored in <c>PRAGMA user_version</c>.
/// Each migration and its version bump run in one transaction, so a failed migration changes nothing.
/// </summary>
public sealed class SchemaMigrator
{
    private readonly SqliteConnectionFactory _connections;
    private readonly IReadOnlyList<IMigration> _migrations;

    public SchemaMigrator(SqliteConnectionFactory connections)
        : this(connections, DefaultMigrations)
    {
    }

    internal SchemaMigrator(SqliteConnectionFactory connections, IReadOnlyList<IMigration> migrations)
    {
        ArgumentNullException.ThrowIfNull(connections);
        ArgumentNullException.ThrowIfNull(migrations);

        for (var i = 0; i < migrations.Count; i++)
        {
            if (migrations[i].Version != i + 1)
            {
                throw new ArgumentException(
                    "Migrations must be numbered 1, 2, 3, ... without gaps.",
                    nameof(migrations));
            }
        }

        _connections = connections;
        _migrations = migrations;
    }

    internal static IReadOnlyList<IMigration> DefaultMigrations { get; } = [new InitialSchemaMigration()];

    /// <summary>
    /// The newest schema version this build understands.
    /// </summary>
    public int LatestVersion => _migrations.Count;

    /// <summary>
    /// Brings the database up to <see cref="LatestVersion"/>. Safe to call repeatedly.
    /// </summary>
    /// <exception cref="UnsupportedSchemaVersionException">The database is newer than this app.</exception>
    public void Migrate()
    {
        using var connection = _connections.Open();

        var current = ReadVersion(connection);
        if (current > LatestVersion)
        {
            throw new UnsupportedSchemaVersionException(
                string.Create(
                    CultureInfo.InvariantCulture,
                    $"The database has schema version {current}, but this app only supports up to {LatestVersion}."));
        }

        foreach (var migration in _migrations.Where(m => m.Version > current))
        {
            using var transaction = connection.BeginTransaction();

            migration.Apply(connection, transaction);

            using var setVersion = connection.CreateCommand();
            setVersion.Transaction = transaction;

            // PRAGMA does not accept parameters. The value is an int we control, not user input.
#pragma warning disable CA2100
            setVersion.CommandText = string.Create(
                CultureInfo.InvariantCulture,
                $"PRAGMA user_version = {migration.Version}");
#pragma warning restore CA2100
            setVersion.ExecuteNonQuery();

            transaction.Commit();
        }
    }

    /// <summary>
    /// Reads the schema version of the database.
    /// </summary>
    public int GetCurrentVersion()
    {
        using var connection = _connections.Open();
        return ReadVersion(connection);
    }

    private static int ReadVersion(SqliteConnection connection)
    {
        using var command = connection.CreateCommand();
        command.CommandText = "PRAGMA user_version";
        return Convert.ToInt32(command.ExecuteScalar(), CultureInfo.InvariantCulture);
    }
}
