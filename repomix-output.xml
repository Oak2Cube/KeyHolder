<Application x:Class="KeyHolder.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B1120" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#151E32" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#26334D" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1E2A44" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
