{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": ["restore", "${workspaceFolder}/KeyHolder.sln"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/KeyHolder.sln",
        "--configuration",
        "Debug",
        "--no-restore"
      ],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/KeyHolder.sln",
        "--configuration",
        "Debug",
        "--logger",
        "console;verbosity=normal"
      ],
      "dependsOn": "build",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "ci",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/KeyHolder.sln",
        "--configuration",
        "Release",
        "--verbosity",
        "normal"
      ],
      "options": {
        "env": {
          "CI": "true"
        }
      },
      "problemMatcher": "$msCompile",
      "group": "test",
      "detail": "Mirrors the GitHub Actions restore/build/test path using locked packages."
    }
  ]
}
