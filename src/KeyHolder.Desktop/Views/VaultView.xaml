<UserControl x:Class="KeyHolder.Desktop.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KeyHolder.Desktop.Converters"
             xmlns:q="clr-namespace:KeyHolder.Domain.Query;assembly=KeyHolder.Domain"
             xmlns:views="clr-namespace:KeyHolder.Desktop.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: search, sort, filter, list. Disabled while an entry is being edited. -->
        <Border Grid.Column="0"
                Padding="14"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel Grid.Row="0">
                    <Button Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewCommand}"
                            Content="+ New entry"
                            Style="{StaticResource PrimaryButton}" />

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,2,0,4" Text="SEARCH" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Searches only the fields chosen below. Several words must all match." />

                    <Expander Header="{Binding SearchOptions.Summary}" ToolTip="Choose 1 to 6 fields to search in">
                        <StackPanel Margin="4,6,0,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Text="Search in (at least one):"
                                       Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding SearchOptions.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="SORT BY" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Name"
                                     GroupName="Sort"
                                     IsChecked="{Binding SortKey, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static q:SortKey.Name}}" />
                        <RadioButton Content="Date"
                                     GroupName="Sort"
                                     IsChecked="{Binding SortKey, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static q:SortKey.Date}}" />
                        <RadioButton Content="Importance"
                                     GroupName="Sort"
                                     IsChecked="{Binding SortKey, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static q:SortKey.Importance}}" />
                    </StackPanel>
                    <CheckBox Margin="0,6,0,0"
                              Content="Descending"
                              IsChecked="{Binding IsSortDescending}"
                              ToolTip="Entries without importance always come last" />

                    <Expander Header="Filter by tags">
                        <StackPanel Margin="4,6,0,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Text="d-tags (type of data)" />
                            <ItemsControl ItemsSource="{Binding DTagFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Text="s-tags (security category)" />
                            <ItemsControl ItemsSource="{Binding STagFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="Clear filters"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding EntryCountText}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding ImportanceText}"
                                               ToolTip="Importance" />
                                </Grid>
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="{Binding Subtitle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Text="{Binding DTagsText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right: empty hint, details, or editor. -->
        <Border Grid.Column="2"
                Padding="24"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Select an entry, or create a new one."
                           Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />

                <!-- Details -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsViewing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedEntry.Title}"
                                   TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Username" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.Username}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Email" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.Email}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="URL" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.Url}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="d-tags (type of data)" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.DTagsText}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="s-tags (security category)" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.STagsText}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Importance" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.ImportanceText}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock MinWidth="160"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="15"
                                       Text="{Binding Secret.PasswordDisplay}" />
                            <Button Command="{Binding Secret.RevealPasswordCommand}"
                                    Content="{Binding Secret.RevealPasswordLabel}" />
                            <Button Command="{Binding Secret.CopyPasswordCommand}" Content="Copy" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock MinWidth="160"
                                       MaxWidth="360"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Secret.NotesDisplay}"
                                       TextWrapping="Wrap" />
                            <Button Command="{Binding Secret.RevealNotesCommand}"
                                    Content="{Binding Secret.RevealNotesLabel}" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding Secret.Message}"
                                   TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Last changed" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.UpdatedText}" />

                        <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                            <Button Command="{Binding EditCommand}" Content="Edit" />
                            <Button Command="{Binding DeleteCommand}"
                                    Content="Delete"
                                    Style="{StaticResource DangerButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Editor -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl Content="{Binding Editor}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <views:EntryEditorView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
