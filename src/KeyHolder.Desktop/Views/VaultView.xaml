<UserControl x:Class="KeyHolder.Desktop.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KeyHolder.Desktop.Converters"
             xmlns:q="clr-namespace:KeyHolder.Domain.Query;assembly=KeyHolder.Domain"
             xmlns:views="clr-namespace:KeyHolder.Desktop.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- Same vertical gap for every radio and checkbox in the left-panel expanders. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="DetailGroup" TargetType="GroupBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Header starts at x=0, the same x as the group's left border and the field labels. -->
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header"
                                              Margin="0,0,0,4"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True" />
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hide is shown in the same golden color as the warning messages. -->
        <Style x:Key="RevealButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Hide">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TagChip">
            <Border Margin="0,0,6,6"
                    Padding="8,3"
                    Background="{StaticResource HoverBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding}" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TagPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: search, sort, filter, list. Disabled while an entry is being edited. -->
        <Border Grid.Column="0"
                Padding="14"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel Grid.Row="0">
                    <Button Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewCommand}"
                            Content="+ New entry"
                            Style="{StaticResource PrimaryButton}" />

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,2,0,4" Text="SEARCH" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Searches only the fields chosen below. Several words must all match." />

                    <Expander Header="Search parameters" ToolTip="Choose 1 to 6 fields to search in">
                        <StackPanel Margin="4,6,0,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Text="Search in (at least one):"
                                       Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding SearchOptions.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Sort by" ToolTip="Sort the entry list">
                        <StackPanel Margin="4,6,0,0">
                            <RadioButton Content="Name"
                                         GroupName="Sort"
                                         IsChecked="{Binding SortKey, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static q:SortKey.Name}}" />
                            <RadioButton Content="Date"
                                         GroupName="Sort"
                                         IsChecked="{Binding SortKey, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static q:SortKey.Date}}" />
                            <RadioButton Content="Importance"
                                         GroupName="Sort"
                                         IsChecked="{Binding SortKey, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static q:SortKey.Importance}}" />
                            <CheckBox Content="Descending"
                                      IsChecked="{Binding IsSortDescending}"
                                      ToolTip="Entries without importance always come last" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Filter by tags">
                        <StackPanel Margin="4,6,0,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Text="Record type" />
                            <ItemsControl ItemsSource="{Binding DTagFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Text="Security category" />
                            <ItemsControl ItemsSource="{Binding STagFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="Clear filters"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding EntryCountText}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding ImportanceText}"
                                               ToolTip="Importance" />
                                </Grid>
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="{Binding Subtitle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Text="{Binding DTagsText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right: empty hint, details, or editor. -->
        <Border Grid.Column="2"
                Padding="24"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Select an entry, or create a new one."
                           Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />

                <!-- Details -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsViewing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left column: the title and the fields directly below it.
                                 Its height does not depend on the "Last changed" block. -->
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedEntry.Title}"
                                           TextWrapping="Wrap" />

                                <StackPanel Visibility="{Binding SelectedEntry.HasUsername, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Username" />
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.Username}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedEntry.HasEmail, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Email" />
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.Email}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedEntry.HasUrl, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="URL" />
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SelectedEntry.Url}" />
                                </StackPanel>

                                <!-- Chips carry a 6 px bottom margin, so the bottom padding is 2 to keep the
                                     gap to the border equal to the top gap (8). -->
                                <GroupBox Style="{StaticResource DetailGroup}"
                                          Padding="12,8,12,2"
                                          Header="Record type"
                                          Visibility="{Binding SelectedEntry.HasDTags, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemTemplate="{StaticResource TagChip}"
                                                  ItemsPanel="{StaticResource TagPanel}"
                                                  ItemsSource="{Binding SelectedEntry.DTagList}" />
                                </GroupBox>

                                <GroupBox Style="{StaticResource DetailGroup}"
                                          Padding="12,8,12,2"
                                          Header="Security category"
                                          Visibility="{Binding SelectedEntry.HasSTags, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemTemplate="{StaticResource TagChip}"
                                                  ItemsPanel="{StaticResource TagPanel}"
                                                  ItemsSource="{Binding SelectedEntry.STagList}" />
                                </GroupBox>

                                <TextBlock Margin="0,16,0,0"
                                           FontSize="16"
                                           Visibility="{Binding SelectedEntry.HasImportance, Converter={StaticResource BoolToVisibility}}">
                                    <Run Foreground="{StaticResource SecondaryTextBrush}" Text="Importance: " />
                                    <Run Text="{Binding SelectedEntry.ImportanceText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Right column: "Last changed", its value, and Edit/Delete. All start at the
                                 left border of the Edit button. -->
                            <StackPanel Grid.Column="1"
                                        Margin="24,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Margin="0,4,0,3"
                                           HorizontalAlignment="Left"
                                           Text="Last changed" />
                                <TextBlock Style="{StaticResource FieldValue}"
                                           HorizontalAlignment="Left"
                                           Text="{Binding SelectedEntry.UpdatedText}" />

                                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                                    <Button Command="{Binding EditCommand}" Content="Edit" />
                                    <Button Command="{Binding DeleteCommand}"
                                            Content="Delete"
                                            Style="{StaticResource DangerButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <GroupBox Style="{StaticResource DetailGroup}"
                                  Header="Deep access level"
                                  Visibility="{Binding SelectedEntry.HasSecretFields, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- Password and notes rows appear only when they have a value. -->
                                <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedEntry.HasPassword, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="Password" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock MinWidth="160"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="15"
                                                   Text="{Binding Secret.PasswordDisplay}" />
                                        <Button Style="{StaticResource RevealButton}"
                                                Command="{Binding Secret.RevealPasswordCommand}"
                                                Content="{Binding Secret.RevealPasswordLabel}" />
                                        <Button Command="{Binding Secret.CopyPasswordCommand}" Content="Copy" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedEntry.HasNotes, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="Notes" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock MinWidth="160"
                                                   MaxWidth="360"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Secret.NotesDisplay}"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{StaticResource RevealButton}"
                                                Command="{Binding Secret.RevealNotesCommand}"
                                                Content="{Binding Secret.RevealNotesLabel}" />
                                        <Button Command="{Binding Secret.CopyNotesCommand}" Content="Copy" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- The message takes space only while it has text. -->
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="{Binding Secret.Message}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Secret.HasMessage, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Editor -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl Content="{Binding Editor}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <views:EntryEditorView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
