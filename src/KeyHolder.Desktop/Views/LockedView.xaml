<UserControl x:Class="KeyHolder.Desktop.Views.LockedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="420"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="20">
            <StackPanel>
                <Border Width="76"
                        Height="76"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        Background="#102D44"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="38">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               Text="LOCKED" />
                </Border>

                <TextBlock HorizontalAlignment="Center"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Text="KeyHolder" />
                <TextBlock Margin="0,10,0,30"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Your vault starts locked."
                           TextAlignment="Center" />

                <Button Height="44"
                        Margin="0"
                        Command="{Binding UnlockCommand}"
                        Content="Unlock"
                        FontSize="14"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />

                <TextBlock Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Milestone 1: no master password yet. Unlock opens a vault of fake demo data. The vault locks again after idle time or when Windows locks."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
