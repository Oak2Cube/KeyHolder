<UserControl x:Class="KeyHolder.Desktop.Views.EntryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KeyHolder.Desktop.Views">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Heading}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="Title (required)" />
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="Username" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="Email" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="URL" />
        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="d-tags: type of data, separated by commas (for example Email, Account)" />
        <TextBox Text="{Binding DTagsText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="s-tags: security category, separated by commas (for example Finance, Sensitive)" />
        <TextBox Text="{Binding STagsText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="Importance (optional whole number, 0 to 100)" />
        <TextBox Width="120"
                 HorizontalAlignment="Left"
                 Text="{Binding ImportanceText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="Password" />
        <PasswordBox views:PasswordBoxBinding.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,3,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="11"
                   Text="{Binding PasswordHint}" />

        <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Length" />
            <TextBox Width="50"
                     Margin="0,0,12,0"
                     Text="{Binding GeneratorLength, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Content="Symbols"
                      IsChecked="{Binding GeneratorSymbols}" />
            <CheckBox Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Content="Avoid look-alikes"
                      IsChecked="{Binding GeneratorAvoidAmbiguous}" />
            <Button Margin="0"
                    Command="{Binding GenerateCommand}"
                    Content="Generate" />
        </WrapPanel>
        <TextBlock Margin="0,4,0,0"
                   Foreground="{StaticResource WarningBrush}"
                   Text="{Binding GeneratorMessage}"
                   TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource EditorLabel}" Text="Notes" />
        <TextBox MinHeight="80"
                 AcceptsReturn="True"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock Margin="0,10,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   Text="{Binding ValidationSummary}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Margin="0,20,0,8" Orientation="Horizontal">
            <Button Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource PrimaryButton}" />
            <Button Command="{Binding CancelCommand}" Content="Cancel" />
        </StackPanel>
    </StackPanel>
</UserControl>
