<UserControl x:Class="KeyHolder.Desktop.Views.EntryIconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{Binding IconSize, RelativeSource={RelativeSource Self}}"
             Height="{Binding IconSize, RelativeSource={RelativeSource Self}}">
    <Border Background="{StaticResource HoverBrush}"
            BorderBrush="{StaticResource BorderBrushColor}"
            BorderThickness="1"
            CornerRadius="8">
        <Viewbox Margin="6" Stretch="Uniform">
            <Path Width="24"
                  Height="24"
                  Data="{Binding Geometry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Fill="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Stretch="Uniform"
                  Stroke="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.2" />
        </Viewbox>
    </Border>
</UserControl>
